# ==============================================================================
# PFE Management Platform - variables pour docker compose
# Copier vers .env :  cp .env.example .env   (Windows : Copy-Item .env.example .env)
# NE JAMAIS commiter .env
# ==============================================================================

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=pfe_management
DB_USERNAME=pfe_user
DB_PASSWORD=change_me_db_password

# --- JWT (base64, 256 bits minimum) : générer avec  openssl rand -base64 48 ---
JWT_SECRET=REMPLACER_PAR_UNE_VALEUR_GENEREE
JWT_EXPIRATION_MS=86400000

# --- CORS : origine du frontend vue par le navigateur ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- URL de l'API vue par le NAVIGATEUR (injectée au build du frontend) ---
FRONTEND_API_URL=http://localhost:8080/api/v1