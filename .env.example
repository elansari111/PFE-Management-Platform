# ==============================================================================
# PFE Management Platform - Configuration d'environnement locale
# ==============================================================================
# ATTENTION : Ne JAMAIS commiter de vrais mots de passe ou secrets dans Git.
# Copiez ce fichier vers .env :
#   Linux / macOS : cp .env.example .env
#   Windows : Copy-Item .env.example .env
# ==============================================================================

# --- Environnement général ---
NODE_ENV=development
APP_NAME=PFE-Management-Platform

# --- Frontend Configuration ---
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:5000/api

# --- Backend Configuration ---
BACKEND_PORT=5000
JWT_SECRET=change_me_super_secret_jwt_key_dev_only_min_32_chars
JWT_EXPIRATION=24h

# --- Base de données ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pfe_db
DB_USER=pfe_user
DB_PASSWORD=pfe_password_dev_insecure
