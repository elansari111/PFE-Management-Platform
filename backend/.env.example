# Backend Configuration - PFE Management Platform
# Use this template for local development. Never commit .env with real production secrets.

# Server
PORT=8080

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pfe_management
DB_URL=jdbc:mysql://localhost:3306/pfe_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=pfe_user
DB_PASSWORD=pfe_password

# CORS Configuration (Frontend origins separated by comma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Actuator / Management
MANAGEMENT_PORT=8080
