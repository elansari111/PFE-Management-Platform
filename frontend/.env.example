# ==============================================================================
# PFE Management Platform - Configuration Environnement Frontend (Vite)
# ==============================================================================
# ATTENTION : Ne JAMAIS inclure de secrets ou clés privées dans les variables VITE_
# car elles sont exposées côté client dans le bundle JavaScript.
# ==============================================================================

# URL de base de l'API Backend Spring Boot
# Le backend écoute par défaut sur le port 8080 avec le préfixe /api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Mode Démonstration / Mocks
# - 'false' : Appels réels vers l'API Backend Spring Boot
# - 'true'  : Utilisation des données fictives explicites (utile pour les modules en cours de dev)
VITE_USE_MOCK=false

# Port de développement local (optionnel, 5173 par défaut)
VITE_PORT=5173

